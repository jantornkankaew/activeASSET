@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

/* ===== Light Theme — Velzon-inspired Clean Professional ===== */
:root {
  --radius: 0.375rem;

  /* Base — Velzon uses very light gray bg (#f3f3f9) */
  --background: oklch(0.972 0.003 270);
  --foreground: oklch(0.20 0.01 260);

  /* Cards — pure white, clean */
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.20 0.01 260);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.20 0.01 260);

  /* Primary — Velzon uses a deep blue-purple (#405189) */
  --primary: oklch(0.40 0.08 270);
  --primary-foreground: oklch(0.985 0 0);

  /* Secondary */
  --secondary: oklch(0.95 0.003 270);
  --secondary-foreground: oklch(0.30 0.01 260);

  /* Muted */
  --muted: oklch(0.95 0.003 270);
  --muted-foreground: oklch(0.50 0.01 260);

  /* Accent — Velzon success green (#0ab39c) */
  --accent: oklch(0.62 0.12 180);
  --accent-foreground: oklch(0.985 0 0);

  /* Destructive — Velzon danger (#f06548) */
  --destructive: oklch(0.62 0.18 25);

  /* Borders — Velzon uses subtle gray (#eff2f7) */
  --border: oklch(0.93 0.003 270);
  --input: oklch(0.93 0.003 270);
  --ring: oklch(0.40 0.08 270);

  /* Charts — Velzon palette */
  --chart-1: oklch(0.40 0.08 270);  /* Primary blue-purple */
  --chart-2: oklch(0.62 0.12 180);  /* Success teal */
  --chart-3: oklch(0.62 0.18 25);   /* Danger orange */
  --chart-4: oklch(0.70 0.15 50);   /* Warning amber */
  --chart-5: oklch(0.55 0.10 310);  /* Info purple */

  /* Sidebar */
  --sidebar: oklch(1 0 0);
  --sidebar-foreground: oklch(0.20 0.01 260);
  --sidebar-primary: oklch(0.40 0.08 270);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.95 0.003 270);
  --sidebar-accent-foreground: oklch(0.30 0.01 260);
  --sidebar-border: oklch(0.93 0.003 270);
  --sidebar-ring: oklch(0.40 0.08 270);
}

/* ===== Dark Theme — Velzon Dark (#2a3042) ===== */
.dark {
  --background: oklch(0.16 0.01 265);
  --foreground: oklch(0.92 0.005 270);

  --card: oklch(0.21 0.01 265);
  --card-foreground: oklch(0.92 0.005 270);
  --popover: oklch(0.21 0.01 265);
  --popover-foreground: oklch(0.92 0.005 270);

  --primary: oklch(0.58 0.10 270);
  --primary-foreground: oklch(0.985 0 0);

  --secondary: oklch(0.27 0.01 265);
  --secondary-foreground: oklch(0.92 0.005 270);

  --muted: oklch(0.27 0.01 265);
  --muted-foreground: oklch(0.62 0.005 270);

  --accent: oklch(0.62 0.12 180);
  --accent-foreground: oklch(0.985 0 0);

  --destructive: oklch(0.65 0.18 25);

  --border: oklch(0.30 0.01 265);
  --input: oklch(0.30 0.01 265);
  --ring: oklch(0.58 0.10 270);

  --chart-1: oklch(0.58 0.10 270);
  --chart-2: oklch(0.62 0.12 180);
  --chart-3: oklch(0.65 0.18 25);
  --chart-4: oklch(0.70 0.15 50);
  --chart-5: oklch(0.55 0.10 310);

  --sidebar: oklch(0.21 0.01 265);
  --sidebar-foreground: oklch(0.92 0.005 270);
  --sidebar-primary: oklch(0.58 0.10 270);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.27 0.01 265);
  --sidebar-accent-foreground: oklch(0.92 0.005 270);
  --sidebar-border: oklch(0.30 0.01 265);
  --sidebar-ring: oklch(0.58 0.10 270);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
    font-feature-settings: "cv11", "ss01";
    font-variation-settings: "opsz" 32;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-size: 14px;
    line-height: 1.5;
  }

  /* Headings — Velzon uses 600 weight, tight tracking */
  h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* Premium scrollbar — Velzon style */
  ::-webkit-scrollbar {
    width: 5px;
    height: 5px;
  }
  ::-webkit-scrollbar-track {
    background: var(--muted);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--muted-foreground);
    border-radius: 4px;
    opacity: 0.5;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--primary);
  }

  /* Selection color */
  ::selection {
    background: var(--primary);
    color: var(--primary-foreground);
    opacity: 0.9;
  }

  /* Focus ring — Velzon style */
  *:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }

  /* Links */
  a {
    color: var(--primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  a:hover {
    color: color-mix(in oklch, var(--primary) 80%, var(--accent));
  }
}

/* ===== Premium utility classes ===== */
@layer utilities {
  /* Glassmorphism variants */
  .glass {
    background: color-mix(in oklch, var(--card) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .glass-strong {
    background: color-mix(in oklch, var(--card) 90%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
  }

  /* Premium shadows — Velzon-style subtle box shadows */
  .shadow-premium {
    box-shadow: 0 0.125rem 0.25rem rgb(33 37 41 / 0.04);
  }
  .shadow-lift {
    box-shadow: 0 0.25rem 0.5rem rgb(33 37 41 / 0.06), 0 0 0 1px rgb(33 37 41 / 0.02);
  }
  .shadow-float {
    box-shadow: 0 0.5rem 1rem rgb(33 37 41 / 0.08), 0 0 0 1px rgb(33 37 41 / 0.02);
  }
  .dark .shadow-premium {
    box-shadow: 0 0.125rem 0.25rem rgb(0 0 0 / 0.2);
  }
  .dark .shadow-lift {
    box-shadow: 0 0.25rem 0.5rem rgb(0 0 0 / 0.3), 0 0 0 1px rgb(255 255 255 / 0.04);
  }
  .dark .shadow-float {
    box-shadow: 0 0.5rem 1rem rgb(0 0 0 / 0.4), 0 0 0 1px rgb(255 255 255 / 0.04);
  }

  /* Glow effects */
  .glow-accent {
    box-shadow: 0 0 24px -4px var(--accent), 0 0 8px -2px var(--accent);
  }
  .glow-primary {
    box-shadow: 0 0 24px -4px var(--primary), 0 0 8px -2px var(--primary);
  }

  /* Gradient backgrounds — Velzon-style subtle gradients */
  .gradient-hero {
    background: linear-gradient(135deg,
      color-mix(in oklch, var(--primary) 4%, var(--card)) 0%,
      var(--card) 50%,
      color-mix(in oklch, var(--accent) 3%, var(--card)) 100%);
  }
  .gradient-brand {
    background: linear-gradient(135deg, var(--primary) 0%, color-mix(in oklch, var(--primary) 75%, var(--chart-5)) 100%);
  }
  .gradient-accent {
    background: linear-gradient(135deg, var(--accent) 0%, color-mix(in oklch, var(--accent) 80%, var(--chart-3)) 100%);
  }

  /* Card with gradient border */
  .card-gradient-border {
    position: relative;
    background: var(--card);
    border-radius: var(--radius);
  }
  .card-gradient-border::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--accent)/30, transparent 50%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Shimmer effect for loading / premium buttons */
  .shimmer {
    position: relative;
    overflow: hidden;
  }
  .shimmer::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.15), transparent);
    transform: translateX(-100%);
    animation: shimmer 2s infinite;
  }
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }

  /* Hover lift — smooth elevation on hover */
  .hover-lift {
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hover-lift:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-float, 0 12px 24px -6px rgb(0 0 0 / 0.08));
  }

  /* Smooth transitions */
  .transition-smooth {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Animated gradient for hero elements */
  .animate-gradient {
    background-size: 200% 200%;
    animation: gradient 8s ease infinite;
  }
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Fade-in animation */
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Scale-in animation */
  .animate-scale-in {
    animation: scaleIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes scaleIn {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }

  /* Slide-in for sheets/drawers */
  .animate-slide-in {
    animation: slideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* Stagger animation children */
  .stagger-children > * {
    animation: fadeIn 0.3s ease-out backwards;
  }
  .stagger-children > *:nth-child(1) { animation-delay: 0ms; }
  .stagger-children > *:nth-child(2) { animation-delay: 50ms; }
  .stagger-children > *:nth-child(3) { animation-delay: 100ms; }
  .stagger-children > *:nth-child(4) { animation-delay: 150ms; }
  .stagger-children > *:nth-child(5) { animation-delay: 200ms; }
  .stagger-children > *:nth-child(6) { animation-delay: 250ms; }

  /* Text gradient */
  .text-gradient {
    background: linear-gradient(135deg, var(--foreground) 0%, color-mix(in oklch, var(--accent) 60%, var(--foreground)) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Mesh background pattern */
  .mesh-bg {
    background-image:
      radial-gradient(at 20% 20%, color-mix(in oklch, var(--accent) 6%, transparent) 0px, transparent 50%),
      radial-gradient(at 80% 80%, color-mix(in oklch, var(--primary) 4%, transparent) 0px, transparent 50%);
  }
}
